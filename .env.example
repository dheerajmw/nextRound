# Public (browser + server)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use Publishable key (sb_publishable_…) OR Legacy tab → anon key (eyJ…). Must match the URL project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: default browser TTS voice name (en). List voices in DevTools:
# speechSynthesis.getVoices().map(v => v.name)
# NEXT_PUBLIC_TTS_VOICE=Google US English

# PostHog (optional in local dev)
NEXT_PUBLIC_POSTHOG_KEY=phc_qrAznJPCDLovKtcYcHsDJpoNWjoPj3wdnjeFDvLjTdf6
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only — never expose to the client
GEMINI_API_KEY=your-gemini-key
OPENROUTER_API_KEY=your-openrouter-key
# Optional fallback model (default openrouter/free)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: ETL seed for Phase 6 (scripts/etl/seed-phase6.mjs)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

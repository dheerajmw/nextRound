# Public (browser + server)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use Publishable key (sb_publishable_…) OR Legacy tab → anon key (eyJ…). Must match the URL project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public app URL for local dev only. On Vercel, use your live URL (not localhost).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only canonical URL for OAuth/email auth (recommended on Vercel production).
# AUTH_SITE_URL=https://next-round-zeta.vercel.app

# On Vercel production, set NEXT_PUBLIC_APP_URL to your live URL (not localhost).
# Also set Supabase → Authentication → URL Configuration:
#   Site URL = https://your-app.vercel.app
#   Redirect URLs = https://your-app.vercel.app/auth/callback

# Optional: default browser TTS voice name (en). List voices in DevTools:
# speechSynthesis.getVoices().map(v => v.name)
# NEXT_PUBLIC_TTS_VOICE=Daniel

# PostHog (optional in local dev)
NEXT_PUBLIC_POSTHOG_KEY=phc_qrAznJPCDLovKtcYcHsDJpoNWjoPj3wdnjeFDvLjTdf6
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only — never expose to the client
# Primary LLM (recommended). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Optional Gemini model (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Fallback LLM — free tier is limited to ~50 requests/day on openrouter/free
OPENROUTER_API_KEY=your-openrouter-key
# Optional OpenRouter model (default openrouter/free). Use a paid model if you add credits.
# OPENROUTER_MODEL=google/gemma-3-27b-it

# Optional: ETL seed for Phase 6 (scripts/etl/seed-phase6.mjs)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
